# Required — your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional — Google Books API key (works without one, just with lower rate limits)
# Leave commented out, or paste a real key on the right of the equals sign.
# GOOGLE_BOOKS_API_KEY=

# Optional — override the model used for each role. Defaults are shown below.
# Chat conversations (per-turn, streamed): Sonnet for speed + cost
# MARGINALIA_CHAT_MODEL=claude-sonnet-4-6
# Taste portrait, delta, librarian-initiated questions (rare, quality matters): Opus
# MARGINALIA_DEEP_MODEL=claude-opus-4-7
# Signal extraction after every chat turn (high-volume, low-stakes): Haiku
# MARGINALIA_SIGNAL_MODEL=claude-haiku-4-5-20251001
